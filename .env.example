NODE_ENV=development
PORT=3001

# Database — Prisma usa una sola URL de conexión
# En Docker: host = nombre del servicio ("db"). Fuera de Docker: localhost
DATABASE_URL="postgresql://postgres:postgres@db:5432/centro_medico"

# Redis
REDIS_URL="redis://redis:6379"

# Internal API (worker)
API_INTERNAL_URL="http://localhost:3001"
API_INTERNAL_SECRET="replace-with-at-least-32-characters"

# JWT
JWT_SECRET="replace-with-at-least-32-characters"
JWT_EXPIRES_IN=8h

# Email delivery through Resend HTTPS API
RESEND_API_KEY=
RESEND_FROM_EMAIL="Centro Médico <onboarding@resend.dev>"

S3_ENDPOINT=https://your-endpoint.storageapi.dev
S3_REGION=auto
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_SIGNED_URL_TTL_SECONDS=43200

APP_TIMEZONE=America/Caracas
NEXT_PUBLIC_APP_TIMEZONE=America/Caracas
