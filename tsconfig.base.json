{
  "compilerOptions": {
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "ES2021",
    "moduleResolution": "node16",
    "declaration": true,
    "removeComments": true,
    "sourceMap": true,
    "incremental": true
  }
}
