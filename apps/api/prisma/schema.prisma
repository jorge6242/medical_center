generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Tenant ───────────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  email     String?
  logoUrl   String?
  logoObjectKey String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  roles           Role[]
  patients        Patient[]
  doctors         Doctor[]
  specialties     Specialty[]
  consultations   Consultation[]
  consultationReminders ConsultationReminder[]
  medicalRecords  MedicalRecord[]
  expenses        Expense[]
  systemConfigs   SystemConfig[]
  exchangeRates   ExchangeRate[]
  services        Service[]
  expenseCategories ExpenseCategory[]
  auditLogs       AuditLog[]
  traceLogs       TraceLog[]
  receiptCounters ReceiptCounter[]
  labTestCatalogs LabTestCatalog[]
  labOrders       LabOrder[]
  doctorServices  DoctorService[]
  accessLinks     TenantAccessLink[]
  doctorPayouts   DoctorPayout[]

  @@map("tenants")
}

// ─── Auth / RBAC ──────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  tenantId     String
  email        String
  passwordHash String
  name         String
  lastName     String? @map("last_name")
  identificationNumber String? @map("identification_number")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  role        Role?    @relation(fields: [roleId], references: [id])
  roleId      String?
  doctor      Doctor?
  auditLogs   AuditLog[]
  traceLogs   TraceLog[]
  doctorReceipts DoctorReceipt[]
  createdDoctorPayouts DoctorPayout[] @relation("DoctorPayoutCreatedBy")
  voidedDoctorPayouts DoctorPayout[] @relation("DoctorPayoutVoidedBy")
  medicalRecords MedicalRecord[]

  onboardingTokens OnboardingToken[]
  createdAccessLinks TenantAccessLink[] @relation("AccessLinkCreatedBy")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("users")
}

model TenantAccessLink {
  id          String    @id @default(uuid())
  tenantId    String
  tokenHash   String    @unique
  createdById String
  expiresAt   DateTime?
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  createdBy User   @relation("AccessLinkCreatedBy", fields: [createdById], references: [id])

  @@index([tenantId])
  @@index([expiresAt])
  @@map("tenant_access_links")
}

enum OnboardingTokenStatus {
  PENDING
  COMPLETED
  EXPIRED
}

model OnboardingToken {
  id          String   @id @default(uuid())
  userId      String
  token       String   @unique
  expiresAt   DateTime
  sentAt      DateTime @default(now())
  completedAt DateTime?
  status      OnboardingTokenStatus @default(PENDING)
  ipAddress   String?
  userAgent   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
  @@index([token])
  @@map("onboarding_tokens")
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  users       User[]
  permissions Permission[]
  version     RoleVersion?

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id       String @id @default(uuid())
  roleId   String
  resource String
  action   String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action])
  @@index([roleId])
  @@map("permissions")
}

model RoleVersion {
  id        String   @id @default(uuid())
  roleId    String   @unique
  version   Int      @default(1)
  updatedAt DateTime @updatedAt

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@map("role_versions")
}

// ─── Pacientes ────────────────────────────────────────────────────────────────

enum DocumentType {
  V
  E
  J
  G
}

enum GenderType {
  MASCULINE
  FEMININE
  OTHER
}

model Patient {
  id           String       @id @default(uuid())
  tenantId     String
  documentType DocumentType
  documentId   String
  name         String
  phone        String?
  email        String?
  birthDate    DateTime?
  gender       GenderType?
  clinicalHistory Json?     @db.JsonB
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  consultations Consultation[]
  labOrders     LabOrder[]
  medicalRecords MedicalRecord[]

  @@unique([tenantId, documentType, documentId])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, documentType, documentId])
  @@map("patients")
}

// ─── Doctores ─────────────────────────────────────────────────────────────────

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  NOT_FOUND
}

model Doctor {
  id              String   @id @default(uuid())
  tenantId        String
  name            String
  lastName        String   @default("")
  email           String?
  phone           String?
  documentType    DocumentType
  documentId      String
  splitPercentage Decimal  @db.Decimal(5, 2)
  primarySpecialtyId String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  medicalLicenseNumber String?
  verificationStatus   VerificationStatus @default(PENDING)
  verifiedAt           DateTime?
  lastVerifiedAt       DateTime?
  lastSacsResponse     String?            @db.Text

  userId       String? @unique
  user         User?   @relation(fields: [userId], references: [id])

  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  primarySpecialty Specialty @relation("DoctorPrimarySpecialty", fields: [primarySpecialtyId], references: [id])
  bankAccounts  DoctorBankAccount[]
  consultations Consultation[]
  medicalRecords MedicalRecord[]
  doctorServices DoctorService[]
  payouts       DoctorPayout[]

  @@unique([tenantId, documentType, documentId])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([primarySpecialtyId])
  @@map("doctors")
}

model DoctorBankAccount {
  id            String   @id @default(uuid())
  doctorId      String
  bankName      String
  accountType   AccountType
  accountNumber String?
  documentId    String
  phone         String?
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@index([doctorId, isDefault])
  @@map("doctor_bank_accounts")
}

enum AccountType {
  SAVINGS
  CHECKING
}

// ─── Especialidades y Servicios ───────────────────────────────────────────────

model Specialty {
  id           String  @id @default(uuid())
  tenantId     String
  name         String
  templateType String?
  isActive     Boolean @default(true)

  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  doctorServices DoctorService[]
  primaryDoctors Doctor[] @relation("DoctorPrimarySpecialty")
  consultationServices ConsultationService[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("specialties")
}

model Service {
  id       String  @id @default(uuid())
  tenantId String
  name     String
  isActive Boolean @default(true)

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  doctorServices DoctorService[]
  consultationServices ConsultationService[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("services")
}

model DoctorService {
  id          String  @id @default(uuid())
  tenantId    String
  doctorId    String
  specialtyId String
  serviceId   String
  priceUsd    Decimal @db.Decimal(12, 2)

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  doctor    Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  specialty Specialty @relation(fields: [specialtyId], references: [id])
  service   Service   @relation(fields: [serviceId], references: [id])

  @@unique([doctorId, specialtyId, serviceId])
  @@index([tenantId])
  @@index([tenantId, doctorId])
  @@index([doctorId])
  @@map("doctor_services")
}

// ─── Consultas ────────────────────────────────────────────────────────────────

enum ConsultationStatus {
  SCHEDULED
  PENDING
  PAID
  VOIDED
}

model Consultation {
  id        String             @id @default(uuid())
  tenantId  String
  patientId String
  doctorId  String
  date      DateTime           @default(now())
  status    ConsultationStatus @default(PENDING)
  notes     String?
  paymentId String?            @unique
  attendedAt DateTime?
  attendedById String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  patient  Patient  @relation(fields: [patientId], references: [id])
  doctor   Doctor   @relation(fields: [doctorId], references: [id])
  payment  Payment? @relation(fields: [paymentId], references: [id])

  services            ConsultationService[]
  consultationPayment ConsultationPayment?
  paymentItem         PaymentItem?
  medicalRecord       MedicalRecord?
  reminders           ConsultationReminder[]

  @@index([tenantId])
  @@index([tenantId, patientId])
  @@index([tenantId, doctorId])
  @@index([tenantId, status])
  @@index([tenantId, date])
  @@map("consultations")
}

enum ConsultationReminderType {
  DAY_BEFORE
}

model ConsultationReminder {
  id             String                    @id @default(uuid())
  tenantId       String
  consultationId String
  type           ConsultationReminderType
  sentAt         DateTime                  @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@unique([consultationId, type])
  @@index([tenantId])
  @@map("consultation_reminders")
}

enum MedicalRecordStatus {
  DRAFT
  COMPLETED
  VOIDED
}

model MedicalRecord {
  id               String             @id @default(uuid())
  tenantId         String
  patientId        String
  doctorId         String
  consultationId   String             @unique
  createdById      String
  templateType     String
  templateVersion  String             @default("1.0.0")
  templateSnapshot Json?
  clinicalData     Json               @db.JsonB
  status           MedicalRecordStatus @default(DRAFT)
  recordedAt       DateTime          @default(now())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  patient     Patient       @relation(fields: [patientId], references: [id])
  doctor      Doctor        @relation(fields: [doctorId], references: [id])
  consultation Consultation @relation(fields: [consultationId], references: [id])
  createdBy   User          @relation(fields: [createdById], references: [id])

  @@unique([tenantId, consultationId])
  @@index([tenantId])
  @@index([tenantId, patientId, recordedAt])
  @@index([tenantId, doctorId])
  @@index([tenantId, templateType])
  @@map("medical_records")
}

model ConsultationService {
  id             String  @id @default(uuid())
  consultationId String
  serviceId      String
  specialtyId    String
  serviceName    String
  specialtyName  String
  priceUsd       Decimal @db.Decimal(12, 2)

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id])
  specialty    Specialty    @relation(fields: [specialtyId], references: [id])

  @@index([consultationId])
  @@map("consultation_services")
}

// ─── Pagos ────────────────────────────────────────────────────────────────────

enum ItemType {
  CONSULTATION
  LAB
}

enum PaymentStatus {
  PENDING
  COMPLETED
  VOIDED
}

enum PaymentMethod {
  CASH_USD
  ZELLE
  WIRE_TRANSFER_USD
  POS_USD_CARD
  POS_BS
  PAGO_MOVIL
}

enum Currency {
  USD
  VES
}

enum DoctorPayoutStatus {
  COMPLETED
  VOIDED
}

model Payment {
  id              String        @id @default(uuid())
  tenantId        String
  idempotencyKey  String?       @unique
  totalServiceUsd Decimal       @db.Decimal(12, 2)
  bcvExchangeRate Decimal       @db.Decimal(12, 4)
  totalPaidUsd    Decimal       @db.Decimal(12, 2)
  totalPaidUsdEquivalent Decimal @db.Decimal(12, 2) @default(0)
  totalPaidBs     Decimal       @db.Decimal(12, 2)
  totalIgtfUsd    Decimal       @db.Decimal(12, 2) @default(0)
  doctorShareUsd  Decimal       @db.Decimal(12, 2)
  centerShareUsd  Decimal       @db.Decimal(12, 2)
  status          PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  consultation        Consultation?
  item                PaymentItem?
  details             PaymentDetail[]
  adjustments         PaymentAdjustment[]
  consultationPayment ConsultationPayment?
  doctorReceipt       DoctorReceipt?
  doctorPayoutItems   DoctorPayoutItem[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt, status])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

model PaymentDetail {
  id                String        @id @default(uuid())
  paymentId         String
  paymentMethod     PaymentMethod
  currency          Currency
  amount            Decimal       @db.Decimal(12, 2)
  referenceNumber   String?
  appliedIgtfAmount Decimal       @db.Decimal(12, 2) @default(0)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_details")
}

model PaymentAdjustment {
  id              String   @id @default(uuid())
  paymentId       String
  paymentDetailId String?
  description     String
  amountUsd       Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  payment       Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_adjustments")
}

model PaymentItem {
  id          String   @id @default(uuid())
  paymentId   String   @unique
  itemType    ItemType
  description String
  quantity    Int      @default(1)
  unitPriceUsd Decimal @db.Decimal(12, 2)
  totalPriceUsd Decimal @db.Decimal(12, 2)

  // Exactly one of these is set, based on itemType
  consultationId String? @unique
  labOrderId     String? @unique

  payment      Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  consultation Consultation? @relation(fields: [consultationId], references: [id])
  labOrder     LabOrder?     @relation(fields: [labOrderId], references: [id])

  @@index([itemType])
  @@index([consultationId])
  @@index([labOrderId])
  @@map("payment_items")
}

enum ConsultationPaymentStatus {
  INITIATED
  PROCESSING
  COMPLETED
  FAILED
  VOIDED
}

model ConsultationPayment {
  id              String                    @id @default(uuid())
  idempotencyKey  String                    @unique
  status          ConsultationPaymentStatus @default(INITIATED)
  consultationId  String                    @unique
  paymentId       String?                   @unique
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  consultation Consultation @relation(fields: [consultationId], references: [id])
  payment      Payment?     @relation(fields: [paymentId], references: [id])

  @@index([idempotencyKey])
  @@map("consultation_payments")
}

// ─── Liquidaciones de Doctor ─────────────────────────────────────────────────

model DoctorPayout {
  id                    String             @id @default(uuid())
  tenantId              String
  doctorId              String
  createdById           String
  voidedById            String?
  status                DoctorPayoutStatus @default(COMPLETED)
  paymentMethod         PaymentMethod
  currency              Currency
  amountUsd             Decimal            @db.Decimal(12, 2)
  paidAmount            Decimal            @db.Decimal(12, 2)
  bcvExchangeRate       Decimal?           @db.Decimal(12, 4)
  referenceNumber       String?
  doctorName            String
  bankName              String
  accountNumber         String?
  bankPhone             String?
  voidReason            String?
  voidedAt              DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  doctor    Doctor             @relation(fields: [doctorId], references: [id])
  createdBy User               @relation("DoctorPayoutCreatedBy", fields: [createdById], references: [id])
  voidedBy  User?              @relation("DoctorPayoutVoidedBy", fields: [voidedById], references: [id])
  items     DoctorPayoutItem[]

  @@index([tenantId, doctorId, status])
  @@index([tenantId, createdAt])
  @@map("doctor_payouts")
}

model DoctorPayoutItem {
  id                   String       @id @default(uuid())
  payoutId             String
  paymentId            String
  totalConsultationUsd Decimal      @db.Decimal(12, 2)
  doctorShareUsd       Decimal      @db.Decimal(12, 2)

  payout  DoctorPayout @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  payment Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([payoutId])
  @@unique([payoutId, paymentId])
  @@index([paymentId])
  @@map("doctor_payout_items")
}

// ─── Recibos de Doctor ────────────────────────────────────────────────────────

enum ReceiptStatus {
  GENERATED
  VOIDED
}

model DoctorReceipt {
  id              String        @id @default(uuid())
  receiptNumber   String        @unique
  paymentId       String        @unique
  generatedById   String
  doctorName      String
  doctorDocument  String
  doctorPhone     String?
  bankName        String
  accountNumber   String
  splitPercentage Decimal       @db.Decimal(5, 2)
  totalConsultation Decimal     @db.Decimal(12, 2)
  doctorShare     Decimal       @db.Decimal(12, 2)
  centerShare     Decimal       @db.Decimal(12, 2)
  status          ReceiptStatus @default(GENERATED)
  generatedAt     DateTime      @default(now())

  payment     Payment @relation(fields: [paymentId], references: [id])
  generatedBy User    @relation(fields: [generatedById], references: [id])

  @@index([receiptNumber])
  @@map("doctor_receipts")
}

// ─── Egresos ──────────────────────────────────────────────────────────────────

enum ExpenseStatus {
  ACTIVE
  VOIDED
}

model ExpenseCategory {
  id       String  @id @default(uuid())
  tenantId String
  name     String
  isActive Boolean @default(true)

  tenant  Tenant    @relation(fields: [tenantId], references: [id])
  expenses Expense[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("expense_categories")
}

model Expense {
  id           String        @id @default(uuid())
  tenantId     String
  categoryId   String
  categoryName String
  description  String
  amountUsd    Decimal       @db.Decimal(12, 2)
  amountBs     Decimal?      @db.Decimal(12, 2)
  status       ExpenseStatus @default(ACTIVE)
  voidedBy     String?
  voidReason   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  category ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("expenses")
}

// ─── Config del Sistema ───────────────────────────────────────────────────────

model SystemConfig {
  id       String @id @default(uuid())
  tenantId String
  key      String
  value    String

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("system_configs")
}

model ExchangeRate {
  id        String           @id @default(uuid())
  tenantId  String
  rate      Decimal          @db.Decimal(12, 4)
  date      DateTime         @db.Date
  source    ExchangeRateSource @default(MANUAL)
  createdAt DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, date])
  @@index([tenantId, date])
  @@map("exchange_rates")
}

enum ExchangeRateSource {
  MANUAL
  API
}

// ─── Auditoría ────────────────────────────────────────────────────────────────

model AuditLog {
  id            String   @id @default(uuid())
  tenantId      String
  userId        String?
  action        String
  entity        String
  entityId      String
  oldValues     Json?
  newValues     Json?
  changedFields String[]
  result        String   @default("SUCCESS")
  correlationId String?
  requestId     String?
  metadata      Json?
  integrityHash String   @default("")
  createdAt     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt])
  @@index([tenantId, correlationId])
  @@index([tenantId, action, entity, createdAt])
  @@map("audit_logs")
}

model TraceLog {
  id            String   @id @default(uuid())
  tenantId      String
  userId        String?
  correlationId String?
  level         String   @default("INFO")
  event         String
  route         String?
  method        String?
  statusCode    Int?
  durationMs    Int?
  metadata      Json
  createdAt     DateTime @default(now())

  tenant Tenant   @relation(fields: [tenantId], references: [id])
  user   User? @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([correlationId])
  @@map("trace_logs")
}

model ReceiptCounter {
  year     Int
  tenantId String
  lastSeq  Int    @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([year, tenantId])
  @@map("receipt_counters")
}

model GeneratedReport {
  id        String   @id @default(uuid())
  jobId     String   @unique
  tenantId  String
  format    String   // 'pdf' | 'excel'
  filename  String
  mimeType  String
  blob      Bytes
  sizeBytes Int
  status    String   // 'pending' | 'processing' | 'completed' | 'failed'
  error     String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([tenantId, createdAt])
  @@index([expiresAt])
  @@map("generated_reports")
}

// ─── Laboratorios ─────────────────────────────────────────────────────────────

enum LabOrderStatus {
  PENDING
  PAID
  VOIDED
}

model LabTestCatalog {
  id       String  @id @default(uuid())
  tenantId String
  name     String
  priceUsd Decimal @db.Decimal(12, 2)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  orderTests LabOrderTest[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("lab_test_catalogs")
}

model LabOrder {
  id        String         @id @default(uuid())
  tenantId  String
  patientId String
  status    LabOrderStatus @default(PENDING)
  totalUsd  Decimal        @db.Decimal(12, 2)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  patient  Patient        @relation(fields: [patientId], references: [id])
  tests    LabOrderTest[]
  paymentItem PaymentItem?

  @@index([tenantId])
  @@index([tenantId, patientId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt, status])
  @@map("lab_orders")
}

model LabOrderTest {
  id          String @id @default(uuid())
  labOrderId  String
  labTestId   String
  testName    String // Snapshot
  priceUsd    Decimal @db.Decimal(12, 2)

  labOrder LabOrder @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  labTest  LabTestCatalog @relation(fields: [labTestId], references: [id])

  @@index([labOrderId])
  @@map("lab_order_tests")
}
